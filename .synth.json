{
  "project": "synth-acp",
  "settings": {
    "communication_mode": "LOCAL",
    "auto_approve_tools": [
      "synth-mcp"
    ],
    "hooks": {
      "on_agent_startup": {
        "active": true
      },
      "on_agent_join": {
        "active": false,
        "recipients": "parent",
        "template": "Agent \"{agent_id}\" is now active. Task: \"{task}\".",
        "kind": "system"
      },
      "on_agent_exit": {
        "active": false,
        "recipients": "parent",
        "template": "Agent \"{agent_id}\" has exited.",
        "kind": "system"
      }
    }
  }
}
